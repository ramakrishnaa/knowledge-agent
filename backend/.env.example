# Copy to .env. Any OpenAI-compatible endpoint works; pick ONE block.

# Groq (default): free key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b

# OpenRouter: free key at https://openrouter.ai/keys; use a model ID ending in ":free"
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<model-id>:free

# Google Gemini: free key at https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...
# LLM_MODEL=gemini-2.5-flash

# Ollama (fully local, no key): install from https://ollama.com, then `ollama pull qwen2.5:3b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Optional
# AGENT_MAX_STEPS=10
# AGENT_MAX_HANDOFFS=4
# Where ChromaDB stores documents (the Docker image uses /data)
# DATA_DIR=./data
# Origins allowed to call the API directly; not needed when the UI proxies /api
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Tracing (optional): pick ONE ------------------------------------------
# Arize Phoenix, open source, self-hosted. Start it with `phoenix serve` (see README),
# then open http://localhost:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Phoenix Cloud: https://app.phoenix.arize.com
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-space>
# PHOENIX_API_KEY=...
# Arize AX (cloud): space ID and API key from https://app.arize.com > Settings
# ARIZE_SPACE_ID=...
# ARIZE_API_KEY=...
# TRACING_PROJECT_NAME=knowledge-agent
